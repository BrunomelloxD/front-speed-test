# Origem da API de speed test. O front acrescenta /api/speed-tests sozinho.
# Formatos aceitos (protocolo opcional; sem protocolo vira https://, ou http:// para localhost):
#   produção: api-speed-test-production.up.railway.app
#   local:    http://localhost:3000   (ou localhost:3000)
# Não inclua /speed-tests, query (?) nem #. O build falha com valor inválido.
# Ausente: `npm run dev` usa o proxy /api do Vite; `npm run build` usa a produção.
VITE_API_URL=http://localhost:3000

# Conexões paralelas no download/upload (4 a 8, padrão 6).
VITE_TEST_CONNECTIONS=6

# Duração de cada fase de download/upload em segundos (10 a 15, padrão 12).
VITE_TEST_DURATION_S=12
